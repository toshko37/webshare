# Webshare Access Control
# =======================

# Prevent Apache from trying index.html (blocked by FilesMatch below) before index.php
# This avoids AH01630 errors in the error log that trigger fail2ban apache-auth
DirectoryIndex index.php

# Force UTF-8 encoding for all text files
AddDefaultCharset UTF-8
AddCharset UTF-8 .md .txt .json
AddType "text/plain; charset=utf-8" .md

# URL Rewriting for clean URLs
RewriteEngine On

# Upload guard pre-filter (docs/upload-guard.md)
# When anonymous uploads require verification (flag file .upload-guard-on exists),
# reject upload POSTs that carry no pass at all BEFORE the request body is read.
# This is only a cheap first filter: upload.php validates the pass itself.
# Allowed through: ?guard=/?pass= query, X-Upload-Pass header, pass cookie,
# login session cookies, and curl/wget when .upload-guard-curl-open exists.
RewriteCond %{REQUEST_METHOD} =POST
RewriteCond %{DOCUMENT_ROOT}/.upload-guard-on -f
RewriteCond %{QUERY_STRING} !(^|&)(guard|pass)=
RewriteCond %{HTTP:X-Upload-Pass} ^$
RewriteCond %{HTTP_COOKIE} !(^|;\s*)(ws_upass|PHPSESSID|ws_remember)=
RewriteCond %{DOCUMENT_ROOT}/.upload-guard-curl-open !-f [OR]
RewriteCond %{HTTP_USER_AGENT} !(curl|wget) [NC]
RewriteRule ^(u|u\.php|upload|upload\.php|u/[a-zA-Z0-9_-]+)$ - [F,L]

# Rewrite /p to /p.php (preserve query string)
RewriteRule ^p$ p.php [QSA,L]

# Rewrite /upload to /upload.php
RewriteRule ^upload$ upload.php [QSA,L]

# Rewrite /u to /u.php (public upload)
RewriteRule ^u$ u.php [QSA,L]

# Rewrite /u/USERNAME to upload.php?user=USERNAME (direct user upload)
RewriteRule ^u/([a-zA-Z0-9_-]+)$ upload.php?user=$1 [QSA,L]

# Rewrite /t/TOKEN to /t.php?token=TOKEN (for viewing shared texts)
# Supports 6-64 char tokens (6=old format, 32=new secure format)
RewriteRule ^t/([a-zA-Z0-9]{6,64})$ t.php?token=$1 [QSA,L]

# Rewrite /t to /t.php (for creating texts)
RewriteRule ^t$ t.php [QSA,L]

# Rewrite /f/TOKEN to /f.php?token=TOKEN (for shared folders)
RewriteRule ^f/([a-zA-Z0-9]{6,64})$ f.php?token=$1 [QSA,L]

# Rewrite /f/TOKEN/upload for folder uploads
RewriteRule ^f/([a-zA-Z0-9]{6,64})/upload$ f.php?token=$1&action=upload [QSA,L]

# Rewrite /f/TOKEN/download for zip download
RewriteRule ^f/([a-zA-Z0-9]{6,64})/download$ f.php?token=$1&action=download [QSA,L]

# Rewrite /get to get.php (installer script)
RewriteRule ^get$ get.php [QSA,L]

# Rewrite /get-speedtest to get-speedtest.php
RewriteRule ^get-speedtest$ get-speedtest.php [QSA,L]

# Rewrite /get-update to get-update.php (remote update script)
RewriteRule ^get-update$ get-update.php [QSA,L]

# Rewrite /get-update-script to get-update-script.php (local bootstrap)
RewriteRule ^get-update-script$ get-update-script.php [QSA,L]

# Authentication is now handled by PHP sessions (not Apache Basic Auth).
# All PHP files are accessible by Apache; security-check.php handles login.

# Deny direct access to sensitive data files
<FilesMatch "^(?!version\.json$).*\.(json|html|htm)$">
    Require all denied
</FilesMatch>

# Version info - public (for update checks)
<FilesMatch "^version\.json$">
    Require all granted
</FilesMatch>

# user.ini.txt is the git copy of .user.ini (installers fetch it from GitHub, not from here)
<FilesMatch "^user\.ini\.txt$">
    Require all denied
</FilesMatch>

# Security Headers (I12). One copy of each: PHP-set duplicates are removed
# ("Header unset" = normal table) and the value is set once in the "always"
# table, which also replaces the same header from the vhost.
# CSP: everything is self-hosted; Turnstile is the only third party.
# 'unsafe-inline' is still needed for the inline scripts/handlers in the pages.
<IfModule mod_headers.c>
    Header unset X-Frame-Options
    Header unset X-Content-Type-Options
    Header unset X-XSS-Protection
    Header unset Referrer-Policy
    Header unset Permissions-Policy
    Header unset Strict-Transport-Security
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "0"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src 'self' blob: https://challenges.cloudflare.com; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# U11: keep share links, upload and chat pages out of search engines
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Disable directory browsing
Options -Indexes

# Protect dotfiles and shell scripts
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(sh|bash)$">
    Require all denied
</FilesMatch>

# U5: documentation, backups, editor leftovers and data files are not public.
# CHANGELOG.md stays public (it is public on GitHub anyway).
<FilesMatch "(?i)(^(?!CHANGELOG\.md$).*\.md$|\.(bak|old|orig|save|swp|swo|tmp|log|sql|dist|mmdb)$|\.bak-|~$)">
    Require all denied
</FilesMatch>

# PHP Configuration for large uploads
# php_value moved to .user.ini (php-fpm, 2026-11-07); kept only for mod_php
# PHP 8 registers as mod_php.c, PHP 7 as mod_php7.c
<IfModule mod_php.c>
    php_value upload_max_filesize 10G
    php_value post_max_size 10G
    php_value max_execution_time 7200
    php_value max_input_time 7200
    php_value memory_limit 512M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 10G
    php_value post_max_size 10G
    php_value max_execution_time 7200
    php_value max_input_time 7200
    php_value memory_limit 512M
</IfModule>
